    "barWidget": "BarWidget.qml"
  },
  "omarchy": {
    "clonedFrom": "omarchy.menu"
  },
  "barWidget": {
    "displayName": "Vault menu",
    "description": "Launches the Vault menu",
    "category": "Compositor",
    "allowMultiple": false
  }
}
